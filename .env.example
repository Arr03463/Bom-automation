# AutoBOM environment configuration template.
#
# Copy this file to `.env` for local development and fill in real values,
# or set these as your hosting platform's secrets/environment variables
# for a deployed instance. NEVER commit a file containing real values --
# `.env` is already git-ignored (see .gitignore).
#
# Every value below is a placeholder. No real credentials are present in
# this file.

# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------

# Which suppliers to try, and in what order, when both are enabled on a
# run. One of: mouser_then_digikey (default), digikey_only.
SUPPLIER_MODE=mouser_then_digikey

# Global dry-run switch for Mouser/DigiKey supplier lookups (product
# search/matching -- not cart/MyList creation, which have their own flags
# below). true = no live network calls, uses mocked responses.
SUPPLIER_DRY_RUN=true

# Persistent successful-lookup cache (src/supplier_lookup_cache.py).
# Disable in any environment where cached results across BOMs/sessions
# would be undesirable (e.g. shared test environments).
SUPPLIER_LOOKUP_CACHE_ENABLED=true
SUPPLIER_LOOKUP_CACHE_PATH=.cache/supplier_lookup_cache.json
SUPPLIER_LOOKUP_CACHE_LOCK_TIMEOUT_SECONDS=10

# Run-directory retention (src/run_retention.py). Applied once per new
# run kick-off, never mid-workflow. Set either to 0 to disable that half
# of the policy.
AUTOBOM_RUN_RETENTION_DAYS=14
AUTOBOM_MAX_RUNS=200

# ---------------------------------------------------------------------------
# Mouser
# ---------------------------------------------------------------------------

MOUSER_BASE_URL=https://api.mouser.com

# Product search/matching API key (src/mouser_client.py).
MOUSER_SEARCH_API_KEY=REPLACE_ME

# Automatic Mouser Cart API creation (src/mouser_cart_client.py). The
# AutoBOM Streamlit app's normal purchasing workflow does NOT use this
# anymore -- it downloads a Mouser export file instead (see
# src/mouser_export.py); these three variables only affect the separate
# src/main.py CLI tool, preserved for a possible future supported
# Mouser sharing integration. Keep MOUSER_CART_ENABLED false unless
# you're specifically using that CLI path.
MOUSER_CART_ENABLED=false
MOUSER_CART_API_KEY=REPLACE_ME
MOUSER_CART_DRY_RUN=true

# ---------------------------------------------------------------------------
# DigiKey
# ---------------------------------------------------------------------------

DIGIKEY_BASE_URL=https://api.digikey.com
DIGIKEY_TOKEN_URL=https://api.digikey.com/v1/oauth2/token

# App registration (client-credentials grant, used for product search).
DIGIKEY_CLIENT_ID=REPLACE_ME
DIGIKEY_CLIENT_SECRET=REPLACE_ME

# 3-legged OAuth (required for MyLists automation). Obtain the initial
# refresh token by running src/digikey_oauth_setup.py locally and
# authorizing against your My DigiKey account; see the deployment guide.
DIGIKEY_REDIRECT_URI=REPLACE_ME
DIGIKEY_REFRESH_TOKEN=REPLACE_ME
# Only needed if you already hold a still-valid access token and want to
# skip the refresh-token exchange entirely; leave blank otherwise.
DIGIKEY_ACCESS_TOKEN=
DIGIKEY_ACCOUNT_ID=

# Locale headers sent on every DigiKey product request.
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=USD
DIGIKEY_LOCALE_SITE=US

# Automatic DigiKey MyList creation (src/digikey_mylists_client.py). Do
# NOT enable in a hosted deployment until a durable DIGIKEY_TOKEN_STORE
# backend below is configured -- see
# Documentation/AutoBOM_DigiKey_Durable_Token_Strategy.md. app.py shows a
# startup warning if this is true without one.
DIGIKEY_MYLISTS_ENABLED=false

# ---------------------------------------------------------------------------
# DigiKey refresh-token durable persistence (src/token_store.py)
# ---------------------------------------------------------------------------
# Backend selection: env_file (default when a local .env exists; local
# dev only), file (a writable persistent directory outside the repo,
# e.g. a mounted volume), http (a generic HTTPS key-value/secrets
# service), or memory (in-process only -- non-durable, the fallback when
# nothing else is configured; see the durable-token strategy doc).

DIGIKEY_TOKEN_STORE=env_file

# Used only when DIGIKEY_TOKEN_STORE=env_file and you want to target a
# non-default .env location.
DIGIKEY_TOKEN_STORE_ENV_PATH=

# Used only when DIGIKEY_TOKEN_STORE=file.
DIGIKEY_TOKEN_STORE_PATH=

# Used only when DIGIKEY_TOKEN_STORE=http. DIGIKEY_TOKEN_STORE_API_KEY
# authenticates AutoBOM to YOUR chosen key-value/secrets service -- it is
# a separate, static secret from the DigiKey refresh token itself, and
# should be supplied via your host's secrets mechanism, never committed.
DIGIKEY_TOKEN_STORE_URL=
DIGIKEY_TOKEN_STORE_API_KEY=REPLACE_ME

# ---------------------------------------------------------------------------
# PartsBox
# ---------------------------------------------------------------------------

PARTSBOX_API_KEY=REPLACE_ME
PARTSBOX_API_BASE_URL=https://api.partsbox.com/api/1
PARTSBOX_DRY_RUN=true
