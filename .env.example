# ============================================================================
# AutoBOM — environment schema (single source of truth for every credential).
#
# Copy this file to `.env` (local dev) or `.env.production` (deploy) and fill
# in real values. `.env*` is gitignored — real secrets never get committed.
#
# GRACEFUL FALLBACK: every Azure-facing var below may be left EMPTY or as its
# <paste…> placeholder for local development. The backend config loader
# (backend/config/settings.py) treats empty/placeholder values as "not
# configured" and falls back to a local behavior that needs no Azure:
#   - No Azure AD creds  -> seed-user login (backend/auth/seed_users.py)
#   - No Graph creds     -> purchasing sheet writes log to console, not OneDrive
# Filled-in values automatically switch that capability to Azure mode. Same
# code path, gated only on whether the var holds a real value.
#
# NAMING NOTE: supplier var names below follow the real repo .env and the
# Supplier API Integration Guide (MOUSER_SEARCH_API_KEY, MOUSER_CART_API_KEY,
# DIGIKEY_CLIENT_ID/SECRET, PARTSBOX_API_KEY). The deployment doc's older single
# `MOUSER_API_KEY` sketch is SUPERSEDED — do not use it.
# ============================================================================

# ---- Environment -----------------------------------------------------------
ENV=development                       # development | production

# ---- App config ------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=<generate-random-64-char-string>

# ---- Database --------------------------------------------------------------
# Local Postgres for dev; Azure Postgres connection string in production.
# Leave empty until Phase 1 wires the DB (Phase 0 runs without it).
DATABASE_URL=postgresql://localhost:5432/autobom_local

# ---- Azure subscription (deploy only — EMPTY for local) --------------------
AZURE_SUBSCRIPTION_ID=<paste-subscription-id-here>
AZURE_TENANT_ID=<paste-tenant-id-here>
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=autobom-dev

# ---- Azure AD app registration / SSO (deploy only — EMPTY for local) -------
# Empty -> backend falls back to seed-user login.
AZURE_AD_CLIENT_ID=<paste-client-id-here>
AZURE_AD_CLIENT_SECRET=<paste-client-secret-here>
AZURE_AD_REDIRECT_URI=https://autobom.azurewebsites.net/api/auth/callback

# ---- Microsoft Graph — Josh's Daily Purchasing List (deploy only) ----------
# Same app registration as SSO. Empty -> sheet writes log to console.
MICROSOFT_GRAPH_TENANT_ID=<same-as-AZURE_TENANT_ID>
MICROSOFT_GRAPH_CLIENT_ID=<same-as-AZURE_AD_CLIENT_ID>
MICROSOFT_GRAPH_CLIENT_SECRET=<same-as-AZURE_AD_CLIENT_SECRET>
ONEDRIVE_PURCHASING_SHEET_ID=<sheet-drive-item-id-goes-here>
ONEDRIVE_DRIVE_ID=<drive-id-for-app-only-access>   # required for app-only Graph writes
ONEDRIVE_PURCHASING_TABLE=PurchasingList           # the 14-column Excel table name

# ============================================================================
# External APIs — SAME in local and Azure modes (real internet APIs, not Azure).
# Copy these from the existing POC .env. Names match the Supplier API Guide.
# ============================================================================

# ---- PartsBox (inventory source of truth) ----------------------------------
PARTSBOX_API_KEY=<from-poc-env>
PARTSBOX_API_BASE_URL=https://api.partsbox.com/api/1
PARTSBOX_DRY_RUN=false

# ---- Mouser (SEARCH and CART use SEPARATE keys) ----------------------------
MOUSER_SEARCH_API_KEY=<from-poc-env>
MOUSER_CART_API_KEY=<from-poc-env>
MOUSER_BASE_URL=https://api.mouser.com
MOUSER_CART_ENABLED=true
MOUSER_CART_DRY_RUN=true               # cart preview only; never SubmitOrder=true

# ---- DigiKey (OAuth 2.0 client credentials) --------------------------------
DIGIKEY_CLIENT_ID=<from-poc-env>
DIGIKEY_CLIENT_SECRET=<from-poc-env>
DIGIKEY_ENV=production                 # production | sandbox (derives base/token host if those are unset)
DIGIKEY_BASE_URL=https://api.digikey.com
DIGIKEY_TOKEN_URL=https://api.digikey.com/v1/oauth2/token
DIGIKEY_LOCALE_SITE=US
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=USD
DIGIKEY_ACCOUNT_ID=                     # optional X-DIGIKEY-Account-Id
DIGIKEY_MYLISTS_ENABLED=true
DIGIKEY_REDIRECT_URI=https://localhost/digikey/callback
DIGIKEY_REFRESH_TOKEN=<from-poc-env-if-using-3-legged>   # 3-legged token for MyLists (run backend/scripts/digikey_oauth_setup.py)

# ---- Supplier safety switches ----------------------------------------------
# mouser_then_digikey | digikey_only
SUPPLIER_MODE=mouser_then_digikey
SUPPLIER_DRY_RUN=false
SUPPLIER_LOOKUP_CACHE_TTL_SECONDS=21600   # supplier lookup cache TTL (6h default)
SUPPLIER_LOOKUP_CACHE_ENABLED=true
# SUPPLIER_LOOKUP_CACHE_PATH=.cache/supplier_lookup_cache.json

# ---- WRITE MODE: the one switch deciding whether flushes are real ----------
# dry_run = build the cart/list payloads and log them, touch nothing at the
#           supplier.  live = actually create the Mouser cart + DigiKey list.
# INDEPENDENT of Microsoft Graph: with no sheet configured a live flush still
# creates the cart/list and logs the sheet rows to console. Never submits an
# order in either mode. Startup default is dry_run when this is unset.
FLUSH_MODE=dry_run

# ---- PartsBox web deep links -----------------------------------------------
# Workspace slug. WITHOUT it, /parts/<id> resolves against whichever workspace
# the viewer's own PartsBox session happens to have selected, so the link lands
# on a foreign parts list instead of the part.
PARTSBOX_WORKSPACE=yanktechinventory
PARTSBOX_WEB_URL=https://partsbox.com
# ID-Anything QR image endpoint. UNVERIFIED — the committed PartsBox PDF is a
# corrupted export; override here (no code change) once a clean spec exists.
# PARTSBOX_QR_URL_TEMPLATE=https://api.partsbox.com/api/1/id-anything/qr/{id}

# ---- Inventory cache --------------------------------------------------------
# /api/inventory returns the WHOLE PartsBox account (~3k parts, ~1MB, ~10s
# cold). This TTL is what keeps repeat loads instant. CLAUDE.md: 60s default,
# Admin-configurable.
INVENTORY_CACHE_TTL_SECONDS=60

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO                          # level for AutoBOM's own loggers

# ---- Deferred features ------------------------------------------------------
DEV_ROLE_ENABLED=false                  # Development role is deferred (CLAUDE.md)

# NOTE: DIGIKEY_ACCESS_TOKEN is intentionally NOT listed. With a refresh token
# present, the 3-legged manager mints and rotates its own; a static value here
# would shadow that and start 401ing the moment it expires.
# NOTE: MOUSER_CART_ENABLED above is not read by any code — kept only so an
# existing .env carrying it is not surprising. Cart behaviour is governed by
# MOUSER_CART_DRY_RUN and FLUSH_MODE.
