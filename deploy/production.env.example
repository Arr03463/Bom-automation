# Production-flavored environment template. This is a NARROWER, opinionated
# view of the full .env.example at the repository root, showing the
# specific values recommended for a production deployment on a host with a
# persistent filesystem (e.g. the Yank remote engineering PC) -- separate
# runtime paths from the source checkout, and a durable DigiKey token
# store. Every value is a placeholder; no real credentials are present.
#
# See Documentation/AutoBOM_Onsite_Deployment_Checklist.md for how this
# fits into the full install procedure, and the root .env.example for
# every other variable this codebase reads (Mouser/PartsBox credentials,
# supplier cache options, etc.) not repeated here.

# --- Runtime data separated from the source checkout ---
# Recommended layout (see Documentation/AutoBOM_Deployment_Guide.md):
#   C:\AutoBOM\prod\repo\       <- source checkout (this application)
#   C:\AutoBOM\prod\data\runs\  <- AUTOBOM_RUNS_ROOT
#   C:\AutoBOM\prod\data\cache\ <- AUTOBOM_CACHE_ROOT
#   C:\AutoBOM\prod\logs\       <- AUTOBOM_LOGS_DIR (service wrapper's log target)
#   C:\ProgramData\AutoBOM\tokens\ <- DIGIKEY_TOKEN_STORE_PATH
AUTOBOM_RUNS_ROOT=C:\AutoBOM\prod\data\runs
AUTOBOM_CACHE_ROOT=C:\AutoBOM\prod\data\cache
AUTOBOM_LOGS_DIR=C:\AutoBOM\prod\logs

# --- Run retention (conservative defaults; raise if disk/traffic justify it) ---
AUTOBOM_RUN_RETENTION_DAYS=14
AUTOBOM_MAX_RUNS=200

# --- Durable DigiKey token store ---
# `file` is the recommended choice for this host (persistent local NTFS
# directory, not shared with development -- see
# Documentation/AutoBOM_DigiKey_Durable_Token_Strategy.md for the `http`
# alternative if a persistent volume isn't available).
DIGIKEY_TOKEN_STORE=file
DIGIKEY_TOKEN_STORE_PATH=C:\ProgramData\AutoBOM\tokens

# --- Streamlit ---
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ENABLE_CORS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# --- Vendor credentials, sourcing/purchasing flags, PartsBox config ---
# See the full .env.example at the repository root for every remaining
# variable (MOUSER_*, DIGIKEY_CLIENT_*, PARTSBOX_*, SUPPLIER_*). Set
# real production values through the deployment's secret mechanism, not
# by committing a filled-in copy of this file.
